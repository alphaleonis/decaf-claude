# Benchmark configuration. Sourced by all scripts.
# Change these to retune the run; every run records the model AND effort it used in meta.json.

# Session model held constant across ALL runs (the fair-comparison anchor).
# Opus 5 — matches how the operator actually runs decaf, so the benchmark measures the configuration
# in use rather than one nobody runs. Its 2026-05 training cutoff is the binding constraint on
# subject vintage (METHODOLOGY-v2 section 6); verified 2026-08-10 that ~19k review-approved PRs
# merged after that date exist across the candidate repos, so the constraint costs nothing.
# Fallback if Opus 5 becomes unavailable: claude-opus-4-7 with Sonnet 4.6 (both cutoff 2026-01).
# Note: some tools hard-pin their own models regardless of this (see tools.json model_policy) —
# anthropic-code-review runs Sonnet review agents and Haiku helpers whatever this is set to, so its
# reviewers sit at a DIFFERENT cutoff than the rest of the roster. That confound cannot be configured
# away; it is accounted for per cell.
BENCH_MODEL="claude-opus-5"

# Reasoning effort held constant across ALL runs — the second fair-comparison anchor.
# Passed explicitly as `--effort`, because otherwise it is AMBIENT: a bare `claude -p` inherits
# whichever of settings.json `effortLevel` / the CLAUDE_EFFORT env var is in force in the shell
# that launched the driver. That makes results depend on who ran them from where, and nothing in
# the artifacts would reveal the difference. Pinning it here also gets it recorded in meta.json.
# Levels: low | medium | high | xhigh (see `claude --help`).
BENCH_EFFORT="high"

# Claude Code CLI binary used to launch each isolated per-cell session.
CLAUDE_BIN="claude"

# Permission posture for the isolated per-cell `claude -p` sessions. EMPTY BY DEFAULT
# (normal permission behavior). Unattended runs need SOME posture because each cell
# autonomously runs gh/bash/subagents to review a PR. YOU must opt in explicitly, choosing
# how much to trust it. Safer -> riskier:
#   --permission-mode acceptEdits      # auto-accept edits, still gates other actions
#   --allowedTools "Bash(gh:*) Bash(git:*) Read Grep Glob Task"   # an explicit allowlist
#   --dangerously-skip-permissions     # no gate at all (reviews are read-only/no-post, but still: your call)
# Leave empty to run cells only where you can answer prompts, or set one of the above.
# Operator-approved (2026-07-16): full bypass. Reviews are read-only / no-post, run against
# public OSS PRs in throwaway shallow checkouts under repos/.
PERM_FLAGS="--dangerously-skip-permissions"

# Repeats per (tool x subject) cell.
REPEATS=2
