# Shallow checkouts of external subject repos, fetched on demand by run_cell.sh.
# Large, reconstructable from the pinned SHAs in subjects/*.json — do not commit.
repos/

# Manifest write lock (flock target).
.manifest.lock

# Audit evidence bundles: large gh dumps, regenerable via v2/audit_subject.sh.
# The verdicts they support live in v2/analysis/GROUND-TRUTH-AUDIT.md, which IS committed.
v2/analysis/subject-*/audit/

# Pooled-subject checkouts (~3.3G), rebuilt by v2/build_pooled_repo.sh from the pinned SHAs
# in each fixture.json. The fixtures and thread sets ARE committed.
v2/pooled/*/repo/

# Null-arm checkouts, rebuilt from the pinned SHAs in each fixture.json.
v2/null/*/repo/
