#!/usr/bin/env bash
# Time-boxed `gh` shim for benchmark v2 cells.
#
# Placed early on PATH so a review agent's `gh` calls land here instead of the real binary.
# Allows read-only lookups of things that ALREADY EXISTED at the checkpoint; refuses anything
# created after it, and refuses query surfaces that cannot be date-bounded at all.
#
# Required env:
#   BENCH_CHECKPOINT_DATE  ISO-8601 date, e.g. 2026-07-07
#   BENCH_REAL_GH          absolute path to the real gh binary
#   BENCH_ACCESS_LOG       file to append access records to
set -uo pipefail

REAL="${BENCH_REAL_GH:-/usr/bin/gh}"
CUTOFF="${BENCH_CHECKPOINT_DATE:?BENCH_CHECKPOINT_DATE not set}"
LOG="${BENCH_ACCESS_LOG:-/dev/null}"

# BENCH_POLICY_DRYRUN=1 makes this script a policy ORACLE: it prints the verdict it would reach and
# exits 0 without running gh or writing the access log. The logging wrapper (shim-log/gh) uses this
# so the unrestricted control arm can be annotated with what the enforcing arm would have done,
# without a second copy of the policy that could drift out of step.
DRYRUN="${BENCH_POLICY_DRYRUN:-0}"

log() { [ "$DRYRUN" = "1" ] && return 0; printf '%s\tgh\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "${*:2}" >> "$LOG"; }

deny() {
  if [ "$DRYRUN" = "1" ]; then echo "DENY $*"; exit 0; fi
  log DENY "$*"
  echo "gh: '$*' is not available in this review environment." >&2
  echo "Only pre-checkpoint read-only lookups are permitted (pr view/diff, issue view, pr list)." >&2
  exit 1
}

# Call immediately before every exec of the real gh.
allow() {
  if [ "$DRYRUN" = "1" ]; then echo "ALLOW $*"; exit 0; fi
  log ALLOW "$*"
}

# created_at of a PR or issue, or empty if it can't be resolved
created_at() { # $1=repo (may be empty) $2=kind(pr|issue) $3=number
  local repoarg=() ; [ -n "$1" ] && repoarg=(-R "$1")
  "$REAL" "$2" view "$3" "${repoarg[@]}" --json createdAt --jq '.createdAt' 2>/dev/null
}

sub="${1:-}"; shift || true

case "$sub" in
  api|graphql|search|auth|secret|ssh-key|gpg-key|config|alias|extension|codespace|gist|release|workflow|run)
    deny "$sub $*" ;;
  pr|issue)
    action="${1:-}"; shift || true
    case "$action" in
      view|list) ;;
      diff)
        # `gh pr diff N` returns the CURRENT/merged diff, which for any checkpoint before the final
        # head is future information. The agent already has the correct diff locally via git.
        deny "$sub diff $* (use the local git diff; gh returns the merged state)" ;;
      *) deny "$sub $action $*" ;;
    esac

    # Discussion carries post-checkpoint content even on a PR that predates the cutoff.
    for a in "$@"; do
      case "$a" in
        --comments) deny "$sub $action $* (--comments may contain post-checkpoint discussion)" ;;
        *comments*|*reviews*|*timelineItems*|*reviewThreads*|*closingIssuesReferences*|*mergedAt*|*mergeCommit*|*state*)
          deny "$sub $action $* (requested field may contain post-checkpoint content)" ;;
      esac
    done

    # A bare `view` prints state (MERGED), reviewers and their approvals, and the milestone — all
    # post-checkpoint facts on a PR that predates the cutoff. Observed leaking `state: MERGED` and
    # `reviewers: ilonatommy (Approved)` for subject 2. Require an explicit safe field selection.
    if [ "$action" = "view" ]; then
      has_json=0; for a in "$@"; do [ "$a" = "--json" ] && has_json=1; done
      if [ $has_json -eq 0 ]; then
        deny "$sub view $* (bare view prints post-checkpoint state/reviewers; use --json with title,body,number,author,createdAt)"
      fi
    fi
    # locate a bare number argument and the -R/--repo value
    num=""; repo=""
    args=("$@"); i=0
    while [ $i -lt ${#args[@]} ]; do
      a="${args[$i]}"
      case "$a" in
        -R|--repo) i=$((i+1)); repo="${args[$i]:-}" ;;
        [0-9]*)    [ -z "$num" ] && num="$a" ;;
      esac
      i=$((i+1))
    done
    # `list` has no single target to date-check, and its output can surface post-checkpoint items
    # (verified: `pr list --search` returned the revert PR's title). Force a server-side date bound.
    if [ "$action" = "list" ]; then
      newargs=(); found_search=0; i=0; args=("$@")
      while [ $i -lt ${#args[@]} ]; do
        a="${args[$i]}"
        if [ "$a" = "--search" ] || [ "$a" = "-S" ]; then
          i=$((i+1)); newargs+=(--search "${args[$i]:-} created:<=$CUTOFF"); found_search=1
        else
          newargs+=("$a")
        fi
        i=$((i+1))
      done
      [ $found_search -eq 0 ] && newargs+=(--search "created:<=$CUTOFF")
      allow "$sub list (date-bounded created:<=$CUTOFF) ${newargs[*]}"
      exec "$REAL" "$sub" list "${newargs[@]}"
    fi

    if [ -n "$num" ]; then
      c="$(created_at "$repo" "$sub" "$num")"
      if [ -z "$c" ]; then deny "$sub $action $num (cannot resolve createdAt)"; fi
      if [[ "${c:0:10}" > "$CUTOFF" ]]; then
        if [ "$DRYRUN" = "1" ]; then echo "DENY $sub $action $num created=${c:0:10} > cutoff=$CUTOFF"; exit 0; fi
        log DENY "$sub $action $num created=$c > cutoff=$CUTOFF"
        echo "gh: $sub #$num was created ${c:0:10}, after this review's checkpoint ($CUTOFF)." >&2
        echo "Information created after the checkpoint is not available." >&2
        exit 1
      fi
      allow "$sub $action $num created=${c:0:10}"
    else
      allow "$sub $action $*"
    fi
    exec "$REAL" "$sub" "$action" "$@"
    ;;
  repo)
    action="${1:-}"
    case "$action" in view) allow "repo view"; shift; exec "$REAL" repo view "$@" ;; *) deny "repo $*" ;; esac ;;
  ""|--help|-h|help) allow "help"; exec "$REAL" --help ;;
  *) deny "$sub $*" ;;
esac
