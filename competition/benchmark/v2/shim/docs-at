#!/usr/bin/env bash
# Date-pinned documentation fetch for benchmark v2 cells.
#
# Replaces WebFetch (which is a harness built-in and cannot be PATH-shimmed, so it is denied via
# --disallowedTools). Fetches a URL as it existed at the review checkpoint, via the Wayback Machine,
# so the agent keeps library/API documentation lookup without seeing anything published later.
#
# Usage: docs-at <url>
#
# Required env:
#   BENCH_CHECKPOINT_DATE  ISO-8601 date, e.g. 2026-07-07
#   BENCH_ACCESS_LOG       file to append access records to
set -uo pipefail

CUTOFF="${BENCH_CHECKPOINT_DATE:?BENCH_CHECKPOINT_DATE not set}"
LOG="${BENCH_ACCESS_LOG:-/dev/null}"
URL="${1:-}"

log() { printf '%s\tdocs-at\t%s\t%s\n' "$(date -u +%FT%TZ)" "$1" "${*:2}" >> "$LOG"; }

if [ -z "$URL" ]; then echo "usage: docs-at <url>" >&2; exit 2; fi

case "$URL" in
  *github.com*|*githubusercontent.com*)
    log DENY "$URL (github host)"
    echo "docs-at: GitHub is not reachable from this review environment." >&2
    echo "Use the local git history and the checked-out working tree instead." >&2
    exit 1 ;;
esac

STAMP="$(printf '%s' "$CUTOFF" | tr -d '-')000000"

# Wayback's /web/<stamp>/ returns the CLOSEST snapshot, which is usually a LATER one — verified: a
# request for 2015 returned 2021, and a request for 2026-05-01 returned 2026-05-21. Asking for the
# closest and then rejecting it makes docs-at refuse almost everything.
#
# The CDX index can be bounded instead: `to=<stamp>` with `limit=-1` returns the most recent capture
# at or before the checkpoint, which is exactly what a reviewer at that date could have read.
CDX="https://web.archive.org/cdx/search/cdx?url=$(printf '%s' "$URL" | sed 's|https\?://||')&to=${STAMP:0:8}&limit=-1&output=json&fl=timestamp&filter=statuscode:200"
picked="$(curl -sS --max-time 30 "$CDX" 2>/dev/null | grep -oE '[0-9]{14}' | tail -1)"

if [ -z "$picked" ]; then
  log MISS "$URL (no capture at or before $CUTOFF)"
  cat >&2 <<EOF
docs-at: the Wayback Machine has no capture of $URL at or before $CUTOFF.

This environment can only serve documentation as it existed at the review checkpoint.
Work from the source in the checked-out tree, its vendored dependencies, and git history.
EOF
  exit 1
fi

SNAP="https://web.archive.org/web/${picked}id_/${URL}"

# Capture the EFFECTIVE url: Wayback redirects to its NEAREST snapshot, which may be NEWER than the
# one requested. Verified: asking for 20150101 of vitest.dev/api returned a 2021 snapshot. Printing
# the date is not enough — a later snapshot is post-checkpoint information, so it is refused.
resp="$(curl -sS -L --max-time 45 -w '\n__HTTP__%{http_code}__URL__%{url_effective}' "$SNAP" 2>/dev/null)"
meta="${resp##*__HTTP__}"; body="${resp%__HTTP__*}"
code="${meta%%__URL__*}"; eff="${meta##*__URL__}"

actual="$(printf '%s' "$eff" | grep -oE '/web/[0-9]{14}' | head -1 | tr -dc '0-9')"

if [ -n "$actual" ] && [ "$actual" \> "$STAMP" ]; then
  log DENY "$URL snapshot=$actual > checkpoint=$STAMP (Wayback served a later snapshot)"
  cat >&2 <<EOF
docs-at: the only archived snapshot of $URL is from ${actual:0:8}, which is AFTER this review's
checkpoint ($CUTOFF). Serving it would leak post-checkpoint information, so it is refused.

Work from the source in the checked-out tree, its vendored dependencies, and git history.
EOF
  exit 1
fi

if [ "$code" = "200" ] && [ -n "${body//[[:space:]]/}" ]; then
  log ALLOW "$URL snapshot=${actual:-$STAMP} http=$code"
  printf '=== docs-at: %s\n=== snapshot %s (checkpoint %s) — verified at or before the checkpoint\n\n' \
    "$URL" "${actual:-$STAMP}" "$CUTOFF"
  printf '%s\n' "$body"
  exit 0
fi

log MISS "$URL snapshot=$STAMP http=$code"
cat >&2 <<EOF
docs-at: no archived snapshot of $URL at or before $CUTOFF (http=$code).

This environment can only serve documentation as it existed at the review checkpoint.
Work from the source in the checked-out tree, its vendored dependencies, and git history.
EOF
exit 1
