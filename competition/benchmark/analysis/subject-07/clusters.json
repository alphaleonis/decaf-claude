[
 {
  "cluster_id": "c1",
  "summary": "USE-AFTER-CLOSE: getChunkSeriesSet's `defer querier.Close()` fires when the helper RETURNS, before the lazily-evaluated ChunkSeriesSet it returns is iterated by StreamChunkedReadResponses. The querier's Close releases the block pendingReaders guard / unmaps the mmap-backed chunk+index readers, so streaming reads chunk bytes from an already-closed (potentially munmap'd) region \u2014 SIGSEGV/SIGBUS or silently corrupted chunk data served to the client.",
  "file": "storage/remote/read_handler.go",
  "line": 247,
  "category": "bug",
